{
  "name": "autopart-backend",
  "version": "1.0.0",
  "description": "Backend API for the AutoParts Marketplace buyer flow",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test jest --runInBand",
    "test:integration": "NODE_ENV=test mocha \"tests/integration/**/*.test.js\" --require tests/setup/mocha.js --exit",
    "lint": "eslint ."
  },
  "keywords": [
    "express",
    "mysql",
    "autoparts",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
